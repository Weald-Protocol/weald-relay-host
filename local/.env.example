# cp .env.example .env. Every line has a working default, so an empty file runs.

# The port the relay answers on. Change it if something else holds 54040.
WEALD_RELAY_PORT=54040

# Which published relay image to run. `auto` resolves the newest release at
# start. A release tag such as wealdrelay-v0.1.5 pins one version, and a digest
# reference is stronger still.
WEALD_RELAY_TAG=auto

# Protects ciphertext at rest. The relay is blind, so this guards a database
# whose contents nobody, including us, can read.
POSTGRES_PASSWORD=weald

# Quotas. Both default to unlimited, which is right until a disk says otherwise.
# WEALD_RELAY_RETENTION_DAYS=365
# WEALD_RELAY_MAX_STORAGE_GB=100
